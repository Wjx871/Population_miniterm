# 本地 shell 配置。复制为 .env.local 后设置随机密钥；不要提交密钥。
YIXUN_AI_API_KEY=replace_with_at_least_32_random_characters
# 默认复用仓库中的 policy-knowledge；容器部署时可设置挂载路径。
# YIXUN_AI_KNOWLEDGE_DIR=/app/policy-knowledge

# 用户禁止在本机下载/运行模型，默认仅保留轻量词法检索。
YIXUN_AI_RETRIEVAL=lexical
YIXUN_AI_RERANK=false
YIXUN_AI_GENERATION_URL=
YIXUN_AI_GENERATION_MODEL=
YIXUN_AI_GENERATION_TIMEOUT=45
YIXUN_AI_GENERATION_PROVIDER=auto
YIXUN_AI_QUERY_EXPANSION=false
# 远程服务需另行明确配置；不自动选供应商、不发送业务数据。
# YIXUN_AI_GENERATION_KEY=...
