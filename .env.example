# Copy to a local, ignored environment file and replace every placeholder.
DB_URL=jdbc:mysql://127.0.0.1:3306/population_miniterm?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
DB_USERNAME=replace_me
DB_PASSWORD=replace_me
JWT_SECRET=replace_with_at_least_32_random_utf8_bytes
JWT_EXPIRE_MINUTES=120
REDIS_ENABLED=false
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0
APP_UPLOAD_DIR=./data/uploads
EXPORT_DIR=./data/exports
LOG_DIR=./logs
AI_PRECHECK_ENABLED=false
AI_PRECHECK_STORAGE_DIR=./data/private-ai-stage
AI_PRECHECK_MAX_MATERIAL_SIZE_MB=10
AI_PRECHECK_READY_RETENTION=PT24H
AI_PRECHECK_COMPLETED_RETENTION=PT24H
AI_PRECHECK_RABBIT_ENABLED=false
AI_PRECHECK_EXCHANGE=population.ai.precheck.exchange
AI_PRECHECK_QUEUE=population.ai.precheck.queue
AI_PRECHECK_ROUTING_KEY=population.ai.precheck.request
AI_PRECHECK_DLX=population.ai.precheck.dlx
AI_PRECHECK_DLQ=population.ai.precheck.dlq
AI_PRECHECK_DLQ_ROUTING_KEY=population.ai.precheck.dead
AI_PRECHECK_CONCURRENCY=2
AI_PRECHECK_PREFETCH=1
AI_PRECHECK_QUEUE_CAPACITY=1000
AI_PRECHECK_MAX_ATTEMPTS=3
AI_PRECHECK_BACKOFF=PT2S,PT10S
AI_PRECHECK_PROCESSING_TIMEOUT=PT125S
AI_PRECHECK_WORKER_LEASE=PT180S
AI_PRECHECK_CONNECT_TIMEOUT=PT2S
AI_PRECHECK_READ_TIMEOUT=PT120S
AI_PRECHECK_ANALYSIS_CLIENT=MOCK
AI_PRECHECK_MOCK_MODE=SUCCESS
AI_PRECHECK_MOCK_DELAY=PT0S
AI_PRECHECK_MOCK_FAILS_BEFORE_SUCCESS=0
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_VHOST=/
# Set credentials only in the ignored local environment file when the broker requires them.
