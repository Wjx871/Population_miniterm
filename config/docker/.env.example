# Copy to config/docker/.env (ignored). Never use a live course/production DB for acceptance.
# Docker Desktop reaches a host database through host.docker.internal, not localhost.
DB_URL=jdbc:mysql://host.docker.internal:3306/population_miniterm_integration_verify?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai
DB_USERNAME=replace_me
DB_PASSWORD=replace_me
JWT_SECRET=replace_with_a_random_secret_at_least_32_bytes_long
WEB_BIND_IP=127.0.0.1
WEB_PORT=8088
# Optional compose.dual.yaml strategy: round_robin, least_conn, ip_hash.
NGINX_LB_STRATEGY=round_robin
# With --profile ocr, set http://ocr:8866. With the original host OCR use http://host.docker.internal:8866.
# Leave empty to run without OCR. Container localhost never points at the Windows host.
IDCARD_OCR_URL=
OCR_AK=
OCR_SK=
# Enable only after primary/replica replication has been verified.
REPLICA_ENABLED=false
REPLICA_DB_URL=
REPLICA_DB_USERNAME=
REPLICA_DB_PASSWORD=
# Optional isolated MySQL lab (compose.mysql.yaml). DB_USERNAME must be a non-root app user.
MYSQL_ROOT_PASSWORD=
REPLICATION_PASSWORD=
# Optional compose.rabbitmq.yaml. Management and AMQP ports remain internal.
RABBITMQ_USERNAME=population
RABBITMQ_PASSWORD=
RABBITMQ_VHOST=/
# Optional cache switches; cloud expiry tests override the dictionary TTL to 3s.
REDIS_ENABLED=true
REDIS_DICTIONARY_TTL=30m
